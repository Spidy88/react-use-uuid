{
  "name": "react-use-uuid",
  "version": "3.0.0",
  "description": "A React Hook for generating a unique id for the lifetime of a Component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spidy88/react-use-uuid.git"
  },
  "keywords": [
    "react",
    "hooks",
    "uuid",
    "typescript",
    "esm"
  ],
  "author": "Nick Ferraro <the.nick.ferraro@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Spidy88/react-use-uuid/issues"
  },
  "homepage": "https://github.com/Spidy88/react-use-uuid#readme",
  "dependencies": {
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.2.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": ">= 16.8.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
